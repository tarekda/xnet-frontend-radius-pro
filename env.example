## Frontend environment (Next.js)
## Local dev: copy to `next-app/.env.local` (or repo root if you symlink / duplicate for scripts).
##
## Windows (PowerShell):
##   Copy-Item env.example next-app\.env.local

# API base URL (inlined at `next build` via NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=https://api.xnetcloud.tech/api

# Optional websocket URL
# NEXT_PUBLIC_WS_URL=ws://localhost:15674

# Docker Compose: NAS defaults for Online Users → Disconnect (injected into runtime `public/env.js`).
# Compose keys still use the legacy `VITE_*` names for backward compatibility with existing `.env` files:
# VITE_DEFAULT_NAS_IP=172.8.16.200
# VITE_DEFAULT_NAS_SECRET=
# VITE_DEFAULT_NAS_COA_PORT=1700

# Optional: Next.js dev proxy target when using same-origin /api (Docker → host backend)
# API_PROXY_TARGET=http://host.docker.internal:23000

# Sentry error reporting (injected into runtime `public/env.js` by Docker entrypoint).
# Leave unset to disable telemetry. Never commit a real DSN to the repo.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

